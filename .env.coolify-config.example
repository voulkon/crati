# ============================================
# Coolify Environment Setup Configuration
# ============================================
# Copy this file to .env.coolify-config and fill in your values
# This file is used by util_scripts/coolify-setup/setup-environment.sh

# ──────────────────────── Cloudflare API ────────────────────────
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone.DNS (Edit)
CLOUDFLARE_API_TOKEN=

# Get your Zone ID from: Cloudflare Dashboard > Select Domain > Overview (right sidebar)
CLOUDFLARE_ZONE_ID=

# Your base domain (without subdomain)
CLOUDFLARE_DOMAIN=crati.co

# ──────────────────────── Server Configuration ──────────────────
# IP address where Coolify/Docker is running
# Can be overridden via CLI: --server-ip=X.X.X.X
SERVER_IP=49.13.136.52

# Enable Cloudflare proxy (orange cloud) to hide origin IP
# true = Proxied through Cloudflare (recommended for security)
# false = DNS only (exposes real IP)
CLOUDFLARE_PROXIED=true

# ──────────────────────── Services to Expose ────────────────────
# Space-separated list of services that should get public subdomains
# These will be accessible at {service}-{env}.{domain}
EXPOSED_SERVICES="jaeger grafana rabbitmq redis-commander flower opensearch_dashboards"

# ──────────────────────── Service Port Mappings ─────────────────
# Internal ports for each service (used by Traefik routing)
SERVICE_PORT_JAEGER=16686
SERVICE_PORT_GRAFANA=3000
SERVICE_PORT_RABBITMQ=15672
SERVICE_PORT_REDIS_COMMANDER=8081
SERVICE_PORT_FLOWER=5555
SERVICE_PORT_OPENSEARCH_DASHBOARDS=5601

# ──────────────────────── Naming Convention ─────────────────────
# Pattern for subdomain naming
# Options:
#   "service-env"  -> jaeger-preview.crati.co
#   "env-service"  -> preview-jaeger.crati.co
SUBDOMAIN_PATTERN=service-env

# ──────────────────────── Security Options ──────────────────────
# Enable HTTP Basic Authentication for auxiliary services
# (Recommended for production environments)
ENABLE_BASIC_AUTH=true

# Basic Auth credentials (if ENABLE_BASIC_AUTH=true)
# These will be used for all auxiliary services
BASIC_AUTH_USERNAME=admin

# Leave empty to auto-generate a strong password
# Or set your own password here
BASIC_AUTH_PASSWORD=

# ──────────────────────── Database Configuration ────────────────
# Default database name pattern
# {env} will be replaced with environment name (e.g., preview, dev)
POSTGRES_DB_PATTERN=crati_{env}

# Default PostgreSQL username
POSTGRES_USER=crati_user

# ──────────────────────── RabbitMQ Configuration ────────────────
# Default RabbitMQ username
RABBITMQ_USER=crati_rabbitmq

# ──────────────────────── Advanced Options ──────────────────────
# DNS TTL (in seconds, 1 = automatic)
DNS_TTL=1

# Enable Cloudflare proxy (orange cloud)
# true = Traffic proxied through Cloudflare (recommended for production)
# false = Direct DNS only (faster for dev/testing)
CLOUDFLARE_PROXIED=false

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
