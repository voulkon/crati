# Crati Environment Variables Template
# Copy this file to .env and fill in your values

# ───────────────────────── Database ─────────────────────────
POSTGRES_USER=crati_user
POSTGRES_PASSWORD=crati_password
POSTGRES_DB=crati_db
DB_HOST=db
DB_PORT=5432

# ───────────────────────── Message Broker ─────────────────────────
RABBITMQ_USER=crati_user
RABBITMQ_PASSWORD=crati_password

# ───────────────────────── Cache ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ───────────────────────── Search Engine ─────────────────────────
OPENSEARCH_URL=http://opensearch:9200
INDEX_THE_OPENSEARCH=true

# ───────────────────────── Observability ─────────────────────────
JAEGER_HOST=jaeger
JAEGER_PORT=4317

# ───────────────────────── Django Settings ─────────────────────────
DEBUG=true
ENABLE_SSL=false
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DB_LOG_LEVEL=WARNING

# ───────────────────────── Worker Settings ─────────────────────────
LIGHT_WORKER=true
WORKER_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# ───────────────────────── Frontend Settings ─────────────────────────
REACT_APP_API_URL=/api

# ───────────────────────── Authentication ─────────────────────────
# Clerk auth is controlled server-side by USE_CLERK_AUTH plus the three
# values below (all from the same Clerk instance, see your Clerk dashboard).
# The backend exposes them at runtime via GET /api/system/config/auth/.
USE_CLERK_AUTH=false
CLERK_SECRET_KEY=
CLERK_JWT_PUBLIC_KEY=
# Not a secret (embedded in every Clerk browser bundle). The backend owns it
# and delivers it to the frontend at runtime — no rebuild needed on rotation.
CLERK_PUBLISHABLE_KEY=
# Optional build-time fallback only; the frontend prefers the runtime value
# from /api/system/config/auth/. Safe to leave empty.
REACT_APP_CLERK_PUBLISHABLE_KEY=

# ───────────────────────── External APIs ─────────────────────────
# Diavgeia API key (optional, for fetching real data)
DIAVGEIA_API_KEY=

# GEMI API key (optional, for company data)
GEMI_API_KEY=

# ───────────────────────── AWS (Production) ─────────────────────────
# For OpenSearch backups and other AWS services
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-north-1

# ───────────────────────── Monitoring (Production) ─────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
FLOWER_BASIC_AUTH=user:password

# ───────────────────────── Production Settings ─────────────────────────
STAGING_MODE=false
STAGING_USERNAME=
STAGING_PASSWORD=
USE_JSON_LOGGING=false

# ───────────────────────── Debug Ports ─────────────────────────
DJANGO_DEBUG_PORT=8002
CELERY_DEBUG_PORT=8004
