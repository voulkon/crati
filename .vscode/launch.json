{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 8002
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/code"
                }
