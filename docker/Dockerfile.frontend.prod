# Build stage
FROM node:20-alpine as build

WORKDIR /app

# The API URL is the only remaining build-time var. Clerk config is NOT a
# build arg anymore — the backend owns it and the frontend receives it at
# runtime via /api/system/config/auth/ (no rebuild needed on key rotation).
ARG REACT_APP_API_URL

# Make it available as an environment variable
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Install dependencies
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# Copy source code and build
COPY frontend/ .

RUN echo "API=$REACT_APP_API_URL"

RUN npm run build

# Production stage - serve static files
FROM nginx:alpine

# Copy built React app to nginx
COPY --from=build /app/build /usr/share/nginx/html

# Copy nginx config file (instead of heredoc)
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000
