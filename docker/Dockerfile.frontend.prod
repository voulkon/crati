# Build stage
FROM node:20-alpine as build

WORKDIR /app

# Add ARG instructions for Clerk and API URL
ARG REACT_APP_CLERK_PUBLISHABLE_KEY
ARG REACT_APP_API_URL

# Make them available as environment variables
ENV REACT_APP_CLERK_PUBLISHABLE_KEY=$REACT_APP_CLERK_PUBLISHABLE_KEY
ENV REACT_APP_API_URL=$REACT_APP_API_URL

# Install dependencies
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

# Copy source code and build
COPY frontend/ .

RUN echo "CLERK=$REACT_APP_CLERK_PUBLISHABLE_KEY" && echo "API=$REACT_APP_API_URL"

RUN npm run build

# Production stage - serve static files
FROM nginx:alpine

# Copy built React app to nginx
COPY --from=build /app/build /usr/share/nginx/html

# Copy nginx config file (instead of heredoc)
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000