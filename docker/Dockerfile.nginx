FROM nginx:alpine

# Install apache2-utils for htpasswd
RUN apk add --no-cache apache2-utils

# Copy nginx config (will be overridden by volume mount anyway)
COPY nginx/local.nginx.conf /etc/nginx/conf.d/default.conf

# Copy the generation script
COPY nginx/generate_htpasswd.sh /docker-entrypoint.d/10-generate-htpasswd.sh
RUN chmod +x /docker-entrypoint.d/10-generate-htpasswd.sh

EXPOSE 80