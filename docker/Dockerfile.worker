# ──────────── STAGE 1: Build dependencies ────────────
FROM python:3.12-slim AS deps-builder

# Build argument to control PyTorch installation
# "default" = use standard PyPI (works for Mac/ARM64 and general use)
# "cpu"     = force CPU-only wheels from PyTorch repo (optimized for Linux x86_64 servers without GPU)
ARG PYTORCH_VERSION=default

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build tools (only needed during build)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry (match host version)
RUN pip install poetry==2.2.1

WORKDIR /code

# Copy poetry files
COPY backend/pyproject.toml backend/poetry.lock ./
COPY backend/gemi ./gemi/

# Configure poetry
RUN poetry config virtualenvs.create false

# Conditionally install CPU-only PyTorch FIRST if PYTORCH_VERSION=cpu
# This prevents downloading 4GB+ CUDA packages on servers without GPU
# Use BuildKit cache mount to persist pip downloads across builds
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$PYTORCH_VERSION" = "cpu" ]; then \
    pip install \
        torch==2.5.1+cpu \
        torchvision==0.20.1+cpu \
        torchaudio==2.5.1+cpu \
        --index-url https://download.pytorch.org/whl/cpu; \
    fi

# Install ALL dependencies (including worker group with docling)
# Use BuildKit cache mounts to persist both pip and poetry caches
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/pypoetry \
    poetry install --no-root --no-interaction --no-ansi --with worker

# ──────────── STAGE 2: Final runtime image ────────────
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /code

# Copy ONLY the installed packages from the builder stage
COPY --from=deps-builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps-builder /usr/local/bin /usr/local/bin

# Copy your application code
COPY backend/ .

# Make entrypoint executable
RUN chmod +x worker_entrypoint.sh