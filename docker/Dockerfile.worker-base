# ──────────────────────────────────────────────────────────
# Base image for Diavgeia Worker with heavy dependencies
# This image contains all Python dependencies and is rebuilt
# only when dependencies change, not on every code change.
# ──────────────────────────────────────────────────────────

FROM python:3.12-slim

# Build argument to control PyTorch installation
# "default" = use standard PyPI with CUDA support (for GPU servers or general use)
# "cpu"     = force CPU-only wheels from PyTorch repo (smaller, optimized for CPU-only servers)
ARG PYTORCH_VERSION=default

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build tools and runtime dependencies in one layer
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry (match host version)
RUN pip install --no-cache-dir poetry==2.2.1

WORKDIR /code

# Copy poetry files
COPY backend/pyproject.toml backend/poetry.lock ./
COPY backend/gemi ./gemi/

# Configure poetry
RUN poetry config virtualenvs.create false

# Conditionally install CPU-only PyTorch FIRST if PYTORCH_VERSION=cpu
# This prevents downloading 4GB+ CUDA packages on servers without GPU
RUN if [ "$PYTORCH_VERSION" = "cpu" ]; then \
    pip install --no-cache-dir \
        torch==2.5.1+cpu \
        torchvision==0.20.1+cpu \
        torchaudio==2.5.1+cpu \
        --index-url https://download.pytorch.org/whl/cpu; \
    fi

# Install ALL dependencies (main + worker groups, excluding dev dependencies)
# This is the most time-consuming step and will be cached in the base image
RUN poetry install --no-root --no-interaction --no-ansi --only main,worker

# Clean up to reduce image size
RUN apt-get purge -y gcc g++ make && \
    apt-get autoremove -y && \
    rm -rf /root/.cache/pip /root/.cache/pypoetry

# Set working directory for the final application
WORKDIR /code
# Trigger build
