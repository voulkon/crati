{
  "id": null,
  "title": "Diavgeia Application Overview",
    "tags": ["diavgeia", "application", "logs"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Log Volume by Service",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (service_name) (rate({environment=\"development\"}[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "displayMode": "list",
              "orientation": "horizontal"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Recent Application Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{environment=\"development\"} |= ``",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 16,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "options": {
          "showTime": true,
          "showLabels": false,
          "showCommonLabels": true,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },
      {
        "id": 3,
        "title": "Backend Service Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{service_name=\"diavgeia-backend\"} |= ``",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 12,
          "w": 12,
          "x": 0,
          "y": 24
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 4,
        "title": "Worker Service Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{service_name=\"diavgeia-worker\"} |= ``",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 12,
          "w": 12,
          "x": 12,
          "y": 24
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 5,
        "title": "Error and Warning Logs",
        "type": "logs",
        "targets": [
          {
            "expr": "{environment=\"development\"} |~ \"ERROR|WARN|WARNING|Exception|Error\"",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 36
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 30,
  "version": 1
}
