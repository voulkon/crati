# Terraform variables file
# Copy this to terraform.tfvars and fill in your values

aws_region = "us-east-1"  # Change to your preferred region

# Database configuration
db_name     = "diavgeia_dev"
db_username = "postgres"
db_password = "your-secure-db-password-here"

# RabbitMQ configuration
mq_username = "admin"
mq_password = "your-secure-mq-password-here"

# Instance sizing (adjust based on your needs and budget)
rds_instance_class        = "db.t3.micro"     # Free tier eligible
redis_node_type          = "cache.t3.micro"   # Free tier eligible
opensearch_instance_type = "t3.small.search"  # Smallest available
mq_instance_type         = "mq.t3.micro"      # Smallest available

# Storage sizing
rds_allocated_storage     = 20   # GB
rds_max_allocated_storage = 100  # GB
opensearch_volume_size    = 10   # GB
